    {
      "id": "hbm-revenue-share",
      "label": "HBM 매출 점유율",
      "dimension": "revenue-share",
      "unit": "%",
      "requiredPatterns": ["hbm", "share|점유율|份额"],
      "excludePatterns": ["gross margin|operating margin|free cash flow|payout|utilization|총마진|영업이익률"],
      "entities": [
        { "id": "skhynix", "company": "SKHY", "aliases": ["SK hynix", "SK Hynix", "SKHY", "하이닉스"] },
        { "id": "samsung", "company": "삼성전자", "aliases": ["Samsung", "삼성전자", "삼성"] },
        { "id": "micron", "company": "마이크론", "aliases": ["Micron", "마이크론"] }
      ],
      "freshnessDays": 190
    },
    {
      "id": "hbm-wafer-input-share",
      "label": "HBM DRAM 웨이퍼 투입 비중",
      "dimension": "wafer-input-share",
      "unit": "%",
      "requiredPatterns": ["hbm", "wafer input|웨이퍼 투입"],
      "excludePatterns": ["bit supply|bit shipment|revenue share"],
      "entities": [
        { "id": "top-three-suppliers", "company": "Top 3 suppliers", "aliases": ["top three suppliers", "three major suppliers", "top 3 suppliers"] }
      ],
      "freshnessDays": 550
    }
  ],
  "consensus": {
    "method": "same-metric-same-period",
    "display": "range-when-sources-disagree",
    "differenceTolerancePctPoint": 0.5,
    "minimumIndependentSourcesForHighConfidence": 2,
    "preserveSourceAndPeriod": true,
    "neverMixDimensions": true
  },
  "eventRules": [
    {
      "id": "earnings-release",
      "label": "분기 실적·어닝콜",
      "patterns": ["quarterly results|earnings release|earnings call|financial results|분기 실적"],
      "priority": "immediate"
    },
    {
      "id": "hbm4-production-stage",
      "label": "HBM4 Sample → Qualification → Ramp",
      "patterns": ["hbm4", "mass production|commercial shipment|qualification|ramp|양산|출하|인증"],
      "priority": "immediate"
    },
    {
      "id": "capacity-commitment",
      "label": "CapEx·Capacity·장기 물량",
      "patterns": ["capex|capital expenditure|capacity|long-term agreement|sold out|설비투자|장기 계약|완판"],
      "priority": "quarterly"
    },
    {
      "id": "competitor-ramp",
      "label": "경쟁사 Ramp·고객 공급",
      "patterns": ["samsung|micron|sk hynix", "hbm4|hbm4e", "shipment|production|ramp|qualification"],
      "priority": "immediate"
    }
  ],
  "retrieval": {
    "mode": "incremental-extractive",
    "onlyChangedDocuments": true,
    "chunkCharacters": 900,
    "chunkOverlapCharacters": 120,
    "maxChunksPerDocument": 14,
    "allowedSourceClasses": ["official", "research"],
    "tracks": [
      {
        "id": "hbm-market-and-ramp",
        "label": "HBM Market & Ramp",
        "terms": ["hbm", "share", "wafer", "qualification", "ramp", "capacity"],
        "decisionQuestion": "점유율 변화가 인증·패키징·공급 배분 중 어느 Gate에서 발생했는가?"
      },
      {
        "id": "workload-and-tco",
        "label": "Workload & TCO",
        "terms": ["kv cache", "offload", "scheduler", "goodput", "tco", "memory tier"],
        "decisionQuestion": "HBM 증설보다 먼저 제거할 Runtime·Memory Placement 병목은 무엇인가?"
      },
      {
        "id": "rag-and-vector-memory",
        "label": "RAG & Vector Memory",
        "terms": ["rag", "retrieval", "vector", "embedding", "cache", "context"],
        "decisionQuestion": "Quality Guardrail 아래 DRAM·CXL·eSSD 배치의 비용 교차점은 어디인가?"
      },
      {
        "id": "capacity-and-contract",
        "label": "Qualification & Capacity",
        "terms": ["capex", "capacity", "long-term", "contract", "shipment", "customer"],
        "decisionQuestion": "발표 물량이 Qualification·Binding Volume·Shipment·매출로 전환되는 조건은 무엇인가?"
      }
    ]
  },
  "evaluation": {
    "framework": "grounded-retrieval-quality-loop",
    "minimumCitationCoveragePct": 100,
    "minimumTrackCoveragePct": 75,
    "minimumFreshDocumentPct": 60,
    "minimumPrimaryOrResearchPct": 80,
    "maximumUnsupportedClaimPct": 0,
    "failClosed": true
  },
  "freshnessScoring": {
    "method": "evidence-freshness-v1",
    "weights": {
      "contentAge": 0.35,
      "embeddingLag": 0.2,
      "staleRetrievalRate": 0.25,
      "coverageDrift": 0.2
    },
    "thresholds": {
      "current": 85,
      "warning": 70
    },
    "defaults": {
      "contentAgeDays": 180,
      "embeddingLagMinutes": 15
    }
  },
  "refreshOrchestration": {
    "strategy": "webhook-first-poll-reconciliation",
    "safetyPollHours": 3,
    "idempotencyLedgerLimit": 100,
    "latencyTargets": {
      "earnings-release": { "minutes": 10 },
      "press-release": { "minutes": 15 },
      "filing-update": { "minutes": 10 },
      "source-update": { "minutes": 30 },
      "industry-report": { "hours": 6 },
      "market-report": { "hours": 24 },
      "scheduled": { "hours": 3 }
    }
  }
}
