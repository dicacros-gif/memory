  "metrics": [
    {
      "id": "hbm-revenue-share",
      "label": "HBM 매출 점유율",
      "dimension": "revenue-share",
      "unit": "%",
      "requiredPatterns": ["hbm", "share|점유율|份额"],
      "excludePatterns": ["gross margin|operating margin|free cash flow|payout|utilization|총마진|영업이익률"],
      "entities": [
        { "id": "skhynix", "company": "SKHY", "aliases": ["SK hynix", "SK Hynix", "SKHY", "하이닉스"] },
        { "id": "samsung", "company": "삼성전자", "aliases": ["Samsung", "삼성전자", "삼성"] },
        { "id": "micron", "company": "마이크론", "aliases": ["Micron", "마이크론"] }
      ],
      "freshnessDays": 190
    },
    {
      "id": "hbm-wafer-input-share",
      "label": "HBM DRAM 웨이퍼 투입 비중",
      "dimension": "wafer-input-share",
      "unit": "%",
      "requiredPatterns": ["hbm", "wafer input|웨이퍼 투입"],
      "excludePatterns": ["bit supply|bit shipment|revenue share"],
      "entities": [
        { "id": "top-three-suppliers", "company": "Top 3 suppliers", "aliases": ["top three suppliers", "three major suppliers", "top 3 suppliers"] }
      ],
      "freshnessDays": 550
    }
  ],
  "consensus": {
    "method": "same-metric-same-period",
    "display": "range-when-sources-disagree",
    "differenceTolerancePctPoint": 0.5,
    "minimumIndependentSourcesForHighConfidence": 2,
    "preserveSourceAndPeriod": true,
    "neverMixDimensions": true
  },
